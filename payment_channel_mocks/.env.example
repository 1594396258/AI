# 独立 Mock 服务监听配置
MOCK_HOST=127.0.0.1
MOCK_PORT=18080
MOCK_DATABASE_PATH=data/mock.db

# 推荐填写。payment_python_tests 使用同一个值调用管理接口。
MOCK_ADMIN_TOKEN=local-demo-admin
MOCK_CALLBACK_TIMEOUT=10
MOCK_MAX_BODY_BYTES=1048576

# 必填：与 Java 测试 PPP 通道配置中的 pin、SecretKey 保持一致。
# 下单校验 Bearer Token + hash；查询只校验 Bearer Token。
PPP_PIN=
PPP_REQUEST_SECRET=

# 仅用于生成模拟回调签名；入站验签不会使用此配置代替 PPP_REQUEST_SECRET。
PPP_CALLBACK_SECRET=

