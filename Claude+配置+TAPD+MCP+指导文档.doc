=80=E9=85=8D=E7=BD=AE (~/.claude.json)</h3>
<pre class=3D"highlight"><code class=3D"language-json">{
  "mcpServers": {
    "mcp-server-tapd": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-tapd"],
      "env": {
        "TAPD_ACCESS_TOKEN": "your_access_token_here",
        "TAPD_API_BASE_URL": "https://api.tapd.cn",
        "TAPD_BASE_URL": "https://www.tapd.cn"
      }
    }
  }
}</code></pre>
