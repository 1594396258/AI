PAYMENT_BASE_URL=http://127.0.0.1:9012/finance-payment-service/v1
MCH_ID=replace_with_test_merchant_id
MCH_PRIVATE_KEY=replace_with_test_merchant_private_key_base64
RESPONSE_PUBLIC_KEY=replace_with_platform_response_public_key_base64

ORDER_NO=replace_with_existing_msg_id
# 仅异常回调用例使用：已有的测试处理中订单及其 PPP 通道订单号。
# 正常回调用例会自己下单并从 FIN_PAY_ORDER 读取，不需要填写这两个值。
EXISTING_PROCESSING_ORDER_NO=
EXISTING_CHANNEL_ORDER_NO=
# Java 测试环境实际接收 PPP 回调的完整 URL；不填时由 PAYMENT_BASE_URL 推导。
PPP_CALLBACK_TARGET_URL=http://127.0.0.1:9012/finance-payment-service/v1/ppp/disburse/notify
NOTIFY_URL=http://127.0.0.1:19090/merchant/notify
REQUEST_TIMEOUT=15
RUN_LIVE_TESTS=false # 设置为 true 后才会调用真实 Java 系统

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=replace_with_test_database
DB_USER=replace_with_test_database_user
DB_PASSWORD=replace_with_test_database_password
DB_CHARSET=utf8mb4

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PROTOCOL=2
REDIS_KEY_PREFIX=payment-auto:

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_with_ai_api_key
AI_MODEL=replace_with_ai_model

# 独立通道 Mock 管理地址。Token 必须和 payment_channel_mocks/.env 一致。
MOCK_BASE_URL=http://127.0.0.1:18080
MOCK_ADMIN_TOKEN=replace_with_test_only_admin_token
MOCK_REQUEST_TIMEOUT=10

# 真实 Java -> 独立 Mock PPP 出站请求回归。
PPP_MOCK_ENABLED=false
# Java 的 pppDisburseUrl/pppDisburseQueryUrl 需在配置中心指向独立 Mock。
PPP_PAY_MERCHANT=replace_with_java_ppp_payMerchant
PPP_PIN=replace_with_java_ppp_pin
PPP_TEST_SECRET=replace_with_java_ppp_secretKey
